# Streamlit Community Cloud → your app → Settings → Secrets.
# Paste these lines there (TOML format). Root-level keys are bridged into
# environment variables by app.py, so core/ modules read them with os.getenv.

MISTRAL_API_KEY = "your-mistral-api-key"
SARVAM_API_KEY = "your-sarvam-api-key"   # optional, for Hindi / Hinglish

# Optional overrides
# MISTRAL_MODEL = "mistral-small-latest"
# WHISPER_MODEL = "base"
