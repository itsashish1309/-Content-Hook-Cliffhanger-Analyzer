# ── HookLens environment ─────────────────────────────────────────────────────
# Copy to .env (local) — never commit .env.
# On Streamlit Community Cloud put the same keys in App settings → Secrets.

# Required: Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=your-mistral-api-key

# Optional but recommended for Hindi / Hinglish: Sarvam API key (https://dashboard.sarvam.ai)
# Without it, Hindi/Hinglish fall back to Whisper (lower accuracy).
SARVAM_API_KEY=

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# MISTRAL_MODEL=mistral-small-latest
# WHISPER_MODEL=base
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_HINGLISH_MODE=translit      # translit (Roman script) | codemix | transcribe | translate
# SARVAM_HINDI_MODE=transcribe       # transcribe (Devanagari) | translit | translate
# MAX_EPISODE_SECONDS=900

# Optional: Netscape-format cookies file for yt-dlp if YouTube asks you to sign in.
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
